# Speed up worktree scans with Git's built-in file-system monitor and untracked cache.
[core]
    fsmonitor = true
    untrackedCache = true

# Keep remote-tracking branches tidy after fetching.
[fetch]
    prune = true
    writeCommitGraph = true

# Stop when pulling would require an implicit merge or rebase.
[pull]
    ff = only

# Set the upstream automatically and strengthen force-with-lease checks.
[push]
    autoSetupRemote = true
    useForceIfIncludes = true

# List recently updated branches first.
[branch]
    sort = -committerdate

# Sort tags by version number.
[tag]
    sort = version:refname

# Arrange branch and tag listings into columns only in a terminal.
[column]
    branch = auto
    tag = auto

# Show the staged diff while composing a commit message in an editor.
[commit]
    verbose = true

# Prompt before running a uniquely matched correction for a mistyped command.
[help]
    autoCorrect = prompt

# Make moved code and low-frequency matching lines easier to identify.
[diff]
    algorithm = histogram
    colorMoved = default
    colorMovedWS = allow-indentation-change

# Reject bare repositories discovered implicitly while walking parent directories.
[safe]
    bareRepository = explicit

# Warn when a remote URL contains plaintext credentials.
[transfer]
    credentialsInUrl = warn

# Include the common ancestor while keeping conflict regions compact.
[merge]
    conflictStyle = zdiff3

# Autosquash fixup commits and stop when an interactive rebase might drop one.
[rebase]
    autoSquash = true
    missingCommitsCheck = error

# Reuse recorded conflict resolutions without updating the index automatically.
[rerere]
    enabled = true
