# Speed up worktree scans with Git's built-in file-system monitor and untracked cache.
[core]
    fsmonitor = true
    untrackedCache = true

# Keep remote-tracking branches tidy after fetching.
[fetch]
    prune = true
    writeCommitGraph = true

# Stop when pulling would require an implicit merge or rebase.
[pull]
    ff = only

# Set the upstream automatically and strengthen force-with-lease checks.
[push]
    autoSetupRemote = true
    useForceIfIncludes = true

# List recently updated branches first.
[branch]
    sort = -committerdate

# Match current and remote-tracking branches to the Catppuccin Frappe palette.
[color "branch"]
    current = "#a6d189 bold"
    remote = "#8caaee"

# Distinguish staged, unstaged, untracked, and conflicted files in status output.
[color "status"]
    added = "#a6d189"
    changed = "#e5c890"
    untracked = "#ef9f76"
    unmerged = "#e78284 bold"

# Sort tags by version number.
[tag]
    sort = version:refname

# Arrange branch and tag listings into columns only in a terminal.
[column]
    branch = auto
    tag = auto

# Show the staged diff while composing a commit message in an editor.
[commit]
    verbose = true

# Prompt before running a uniquely matched correction for a mistyped command.
[help]
    autoCorrect = prompt

# Make moved code and low-frequency matching lines easier to identify.
[diff]
    algorithm = histogram
    colorMoved = dimmed-zebra
    colorMovedWS = allow-indentation-change
    # Join nearby hunks and highlight whitespace errors throughout the diff.
    interHunkContext = 3
    wsErrorHighlight = all

# Show patches and any saved untracked files when inspecting a stash.
[stash]
    showPatch = true
    showIncludeUntracked = true

# Match diff headings to the Catppuccin Frappe palette.
[color "diff"]
    meta = "#ca9ee6 bold"
    frag = "#8caaee bold"
    func = "#babbf1"
    whitespace = "#303446 #e78284"

# Reject bare repositories discovered implicitly while walking parent directories.
[safe]
    bareRepository = explicit

# Warn when a remote URL contains plaintext credentials.
[transfer]
    credentialsInUrl = warn

# Include the common ancestor while keeping conflict regions compact.
[merge]
    conflictStyle = zdiff3

# Keep related branches aligned, retry failed exec commands, autosquash fixups,
# and stop when an interactive rebase might drop a commit.
[rebase]
    autoSquash = true
    missingCommitsCheck = error
    updateRefs = true
    rescheduleFailedExec = true

# Reuse recorded conflict resolutions without updating the index automatically.
[rerere]
    enabled = true
