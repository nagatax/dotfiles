# Treat this directory as the root of the EditorConfig hierarchy.
root = true

# ==================================================
# Common settings
# Apply consistent defaults to every file.
# ==================================================

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

# ==================================================
# Language settings
# Override indentation for programming languages.
# ==================================================

[*.{html,css,js}]
indent_style = space
indent_size = 2

[*.{php,c,cpp,rb,java,py}]
indent_style = space
indent_size = 4

[{*.sh,*.zsh,.zshrc,.zprofile,.zshenv}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

# ==================================================
# File settings
# Override formatting for specific file types.
# ==================================================

[*.md]
# Preserve trailing spaces because two trailing spaces create a Markdown line break.
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

[*.{xml,yml,yaml,json}]
indent_style = space
indent_size = 2

[Dockerfile*]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4

[*.{vimrc,vim}]
indent_style = space
indent_size = 2

[*.lua]
indent_style = space
indent_size = 2
