# ==================================================
# Font
# Configure the terminal font and text size.
# ==================================================

font-family = JetBrains Mono
font-size = 18
# Strengthen text strokes without increasing the font size on macOS.
font-thicken = true
font-thicken-strength = 100
# Add a little vertical breathing room without changing the font size.
adjust-cell-height = 5%


# ==================================================
# Theme
# Set the terminal color scheme.
# ==================================================

theme = Catppuccin Frappe

# Prevent text from becoming indistinguishable from the background.
minimum-contrast = 1.1


# ==================================================
# Cursor / Mouse
# Configure cursor animation and pointer visibility.
# ==================================================

cursor-style-blink = false
mouse-hide-while-typing = true


# ==================================================
# Window / Splits
# Configure window spacing, persistence, and split appearance.
# ==================================================

window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
# Extend full-screen application backgrounds into the balanced padding.
window-padding-color = extend

# Restore the previous window state when Ghostty starts.
window-save-state = always

# Make the focused split visually stand out.
unfocused-split-opacity = 0.70
unfocused-split-fill = #292c3c
split-divider-color = #626880


# ==================================================
# Clipboard
# Copy selected text directly to the system clipboard.
# ==================================================

copy-on-select = clipboard


# ==================================================
# Terminal / Shell Integration
# Configure terminal history and shell-provided features.
# ==================================================

scrollback-limit = 20000000

# Enable prompt navigation, sudo terminfo preservation, titles, and SSH integration.
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path


# ==================================================
# Notifications
# Notify when a long-running command finishes in an unfocused terminal.
# ==================================================

notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s


# ==================================================
# macOS
# Use the Option key as Alt for terminal shortcuts.
# ==================================================

macos-option-as-alt = true


# ==================================================
# Keybindings
# Configure split management and prompt navigation with direct Alt shortcuts.
# ==================================================

# Navigate between splits.
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right
keybind = alt+n=goto_split:next
keybind = alt+p=goto_split:previous

# Create splits left/down/up/right with Alt+m/comma/period/slash.
keybind = alt+m=new_split:left
keybind = alt+,=new_split:down
keybind = alt+.=new_split:up
keybind = alt+/=new_split:right

# Jump between shell prompts recorded by shell integration.
keybind = alt+u=jump_to_prompt:-1
keybind = alt+d=jump_to_prompt:1
